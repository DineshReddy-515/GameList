{
  "name": "gamelist-backend",
  "version": "1.0.0",
  "description": "Node Express backend server for GameList",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node db/seed.js",
    "seed:reset": "node db/seed.js --reset",
    "seed:small": "node db/seed.js --pages=2",
    "sync": "node db/syncAll.js",
    "sync:resume": "node db/syncAll.js",
    "sync:status": "node db/syncAll.js --status",
    "sync:reset": "node db/syncAll.js --restart",
    "sync:batch": "node db/syncAll.js --pages=100"
  },
  "keywords": [
    "express",
    "node",
    "gamelist",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.9",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "node-fetch": "^3.3.2",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
